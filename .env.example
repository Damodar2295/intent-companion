# No external requests are made with the defaults.
PORT=8090
DEMO_MODE=true
# Optional: defaults to var/companion.sqlite3 relative to this project.
# DATABASE_PATH=/absolute/path/to/companion.sqlite3
AI_PROVIDER=deterministic
# Optional OpenAI-compatible full chat-completions endpoint. Model access is provider-specific.
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=8
# Optional JSON overrides; accepted signal types are documented in docs/architecture.md.
INTENT_WEIGHTS_JSON={}
BUSINESS_WEIGHTS_JSON={}
DEMO_NOW=2026-09-17T12:00:00+00:00
# FIXTURE_DIR=data
# Frontend development settings belong in frontend/.env.local:
# FRONTEND_PORT=5174
# BACKEND_PROXY=http://127.0.0.1:8090

# Outing discovery: exactly one mode must be true. Legacy AI_PROVIDER is independent.
REALTIME_MODE=false
OPENAI_API_KEY=
# Required in realtime mode; choose a model supporting Responses structured outputs.
OPENAI_MODEL=
SEARCH_PROVIDER=brave
SEARCH_API_KEY=
PLACES_PROVIDER=google
PLACES_API_KEY=
ROUTING_PROVIDER=google
ROUTING_API_KEY=
EVENT_PROVIDER=ticketmaster
EVENT_API_KEY=
AMEX_DATA_MODE=synthetic
OUTING_DEADLINE_SECONDS=60
OUTING_PROVIDER_TIMEOUT_SECONDS=8
OUTING_CATALOG_REFRESH_DAYS=30
OUTING_DEBUG=false
# Exact, operator-verified official organizer hosts allowed for bounded JSON-LD extraction.
# Empty means no arbitrary web-page fetching; search snippets never become verified facts.
OFFICIAL_SOURCE_HOSTS=
# Optional JSON policies (all six weights must sum to 1):
# OUTING_RANKING_WEIGHTS={"relevance":0.30,"preferences":0.20,"evidence":0.20,"travel":0.15,"budget":0.10,"value":0.05}
# OUTING_FIELD_SOURCE_PRIORITY={"price":{"OFFICIAL_ORGANIZER":100,"TICKETING_API":90}}
# OUTING_LLM_PRICE_TABLE={"your-model":{"input_per_million":0,"output_per_million":0}}
# Optional reviewed branch mappings; no live mappings are supplied by this prototype.
# OUTING_MERCHANT_MAPPINGS=[{"merchant_id":"merchant-01","place_id":"reviewed-google-place-id"}]

# Shared model gateway: configured preserves existing opt-in provider settings.
# mock uses only explicitly injected operation fixtures; never sends model requests.
LLM_GATEWAY_MODE=configured
LLM_ROUTES_JSON={}
# Optional per-operation override (no model name is hardcoded):
# LLM_ROUTES_JSON={"recommendation.ranking":{"adapter":"chat","model":"your-model","model_class":"standard"}}
# SafeChain is not installed; selecting an unavailable adapter fails without fallback.
OPENAI_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses

# Phase 3 index: no embeddings generated automatically on startup.
# Default storage uses DATABASE_PATH with additive retrieval_* tables.
# RETRIEVAL_DATABASE_PATH=/absolute/path/to/local-index.sqlite3
EMBEDDING_MODE=disabled
# Explicit local pipeline testing only: EMBEDDING_MODE=test_hash (not semantic embeddings).
EMBEDDING_DIMENSIONS=64
# Real embeddings through the existing OpenAI provider (opt in with EMBEDDING_MODE=openai).
# Uses OPENAI_API_KEY above. No model is hardcoded in application code.
EMBEDDING_MODEL=
# Example: text-embedding-3-small
EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
EMBEDDING_TIMEOUT_SECONDS=10
# Optional, for models supporting dimensions; omit to use the model's native size.
# EMBEDDING_OUTPUT_DIMENSIONS=1536
# Use a separate index from test_hash: RETRIEVAL_DATABASE_PATH=var/openai-embeddings.sqlite3

# Phase 4 deterministic intent service. Model extraction is an optional review-only draft.
INTENT_PLANNING_THRESHOLD=0.4
SIGNAL_TTL_DAYS_JSON={}
# Example: {"event_search":2,"event_booking":7}
INTENT_EXTRACTION_MODE=deterministic
# mock exercises the shared gateway locally; llm uses intent.entity_extraction's configured route.

# Phase 5 requirements planning (no discovery): auto uses mock in demo, LLM in realtime.
SEARCH_PLAN_MODE=auto
SEARCH_PLAN_TIMEOUT_SECONDS=15

# Phase 6 bounded provider execution
TOOL_CONCURRENCY=4
TOOL_MAX_CALLS=10
TOOL_TIMEOUT_SECONDS=8
TOOL_RUN_DEADLINE_SECONDS=30
TOOL_RESULT_LIMIT=20

# Phase 7 hybrid retrieval
RETRIEVAL_RRF_K=60
RETRIEVAL_TIMEOUT_SECONDS=10
RETRIEVAL_CONCURRENCY=4

# Phase 8 reranking (disabled by default; test_hash is explicitly a test double)
RERANKER_MODE=disabled
RERANKER_THRESHOLD=0.25
RERANKER_TOP_K=20

# Phase 9 uses request-scoped token budgets; no new provider configuration.
